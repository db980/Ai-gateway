FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 5000

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY backend/AIGateway.sln .
COPY backend/src/AIGateway.Domain/AIGateway.Domain.csproj src/AIGateway.Domain/
COPY backend/src/AIGateway.Application/AIGateway.Application.csproj src/AIGateway.Application/
COPY backend/src/AIGateway.Infrastructure/AIGateway.Infrastructure.csproj src/AIGateway.Infrastructure/
COPY backend/src/AIGateway.Persistence/AIGateway.Persistence.csproj src/AIGateway.Persistence/
COPY backend/src/AIGateway.API/AIGateway.API.csproj src/AIGateway.API/
RUN dotnet restore src/AIGateway.API/AIGateway.API.csproj
COPY backend/ .
WORKDIR /src/src/AIGateway.API
RUN dotnet build -c Release -o /app/build

FROM build AS publish
RUN dotnet publish -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENV ASPNETCORE_URLS=http://+:5000
ENTRYPOINT ["dotnet", "AIGateway.API.dll"]
